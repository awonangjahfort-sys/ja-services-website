# --- Supabase ---
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key -- SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_.
# Used to bypass RLS in the payment webhook and admin routes.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments ---
# Which adapter is active: campay | cinetpay | notchpay (only campay is implemented so far)
PAYMENT_PROVIDER=campay

# Campay (https://campay.net -- get these after creating an app in the dashboard)
CAMPAY_APP_USERNAME=
CAMPAY_APP_PASSWORD=
# Sandbox: https://demo.campay.net/api  |  Live: https://www.campay.net/api
CAMPAY_BASE_URL=https://www.campay.net/api
